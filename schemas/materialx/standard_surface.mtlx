<?xml version="1.0" encoding="UTF-8"?>
<materialx version="1.38">
  <!-- OpenLore Standard Surface Material Template -->
  <standard_surface name="SR_robot_armor" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.7, 0.72, 0.75" />
    <input name="metalness" type="float" value="0.9" />
    <input name="specular_roughness" type="float" value="0.25" />
    <input name="emission" type="float" value="0.0" />
  </standard_surface>
  <surfacematerial name="M_robot_armor" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_robot_armor" />
  </surfacematerial>
</materialx>
