@prefix : <https://openlore.io/ontology/characters#> .
@prefix canon: <https://openlore.io/ontology/canon#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openlore.io/ontology/characters> a owl:Ontology ;
    owl:imports <https://openlore.io/ontology/canon> ;
    rdfs:label "OpenLore Character Lifecycle Ontology" .

:CharacterLifecycle a owl:Class ;
    rdfs:label "Character Lifecycle" ;
    rdfs:comment "Spatiotemporal bounds and status events for a character within a timeline." .

:birthTime a owl:DatatypeProperty ;
    rdfs:domain canon:Character ;
    rdfs:range xsd:dateTime .

:deathTime a owl:DatatypeProperty ;
    rdfs:domain canon:Character ;
    rdfs:range xsd:dateTime .

:status a owl:DatatypeProperty ;
    rdfs:domain canon:Character ;
    rdfs:range xsd:string .
